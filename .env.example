# Application
ENV=local

# Database (shared Docker network: hostname is "db")
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=app

# SQLAlchemy URLs used by the app and Alembic in local/dev
DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Separate test DB (if you want to run a local test DB with Docker)
TEST_POSTGRES_DB=app_test
TEST_DATABASE_URL=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${TEST_POSTGRES_DB}

# Auth (mock if not set; Supabase Auth integration later)
SUPABASE_JWT_PUBLIC_KEY=
JWT_SECRET_KEY=